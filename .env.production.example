# =============================================================================
# Production API env template. Do NOT commit real secrets.
#
# Prefer SSM /dsa-sheet/* → infra/ec2-bootstrap.sh → /etc/dsa-sheet/api.env
# Compose (docker-compose.prod.yml) overrides Redis to redis://redis:6379.
# Web app has no env file — relative /api on the same HTTPS CloudFront origin.
# Guide: docs/DEPLOYMENT_GUIDE.md
# =============================================================================

NODE_ENV=production
PORT=4000

# Atlas SRV. Database name: dsa-sheet.
# Allowlist = current EC2 public IPv4 /32 only (no Elastic IP in this deploy).
# After EC2 Stop/Start, update Atlas with the new public IP.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dsa-sheet?retryWrites=true&w=majority
MONGO_POOL_SIZE=50

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

# ≥32 random chars
JWT_ACCESS_SECRET=replace-with-long-random-secret

# SECURITY REQUIRED for public deploy: true only behind HTTPS (CloudFront)
COOKIE_SECURE=true

# Exact CloudFront URL, no trailing slash
CORS_ORIGIN=https://xxxx.cloudfront.net

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=30
SHEET_CACHE_TTL_SECONDS=3600
