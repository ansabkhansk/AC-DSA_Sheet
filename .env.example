# =============================================================================
# Local development template (API only).
# Copy to `.env` at the monorepo root. Never commit `.env`.
# Loaded by apps/api/src/config/env.ts. The web app has NO env file (uses `/api`).
# Production values: see `.env.production.example` and docs/DEPLOYMENT_GUIDE.md.
# =============================================================================

# development | test | production
# Required. Local: development. Where: local `.env` only for day-to-day work.
NODE_ENV=development

# Port the API listens on (Vite proxies /api here). Default 4000.
# Required. Where: local `.env`.
PORT=4000

# MongoDB connection string. Local compose: infra/docker-compose.yml.
# Required. Where: local `.env`. Example for Docker Desktop Mongo:
MONGO_URI=mongodb://localhost:27017/dsa-sheet

# Optional. Mongoose pool size (default 50). Where: local `.env`.
MONGO_POOL_SIZE=50

# Redis. Local compose exposes localhost:6379. Set REDIS_ENABLED=false to skip Redis.
# REDIS_URL is required when REDIS_ENABLED=true.
# Where: local `.env`.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# JWT signing secret for access tokens (min 8 chars; use a long random string).
# Required. Local placeholder only — never reuse in production.
# Where: local `.env`.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret

# httpOnly cookie Secure flag. false for http://localhost; true behind HTTPS.
# Where: local `.env`.
COOKIE_SECURE=false

# Allowed browser Origin for CORS (credentials). Vite default below.
# Required. Where: local `.env`.
CORS_ORIGIN=http://localhost:5173

# Pino level: fatal | error | warn | info | debug | trace | silent
# Optional (default info). Where: local `.env`.
LOG_LEVEL=info

# Rate limiting (P8). Window ms; max requests per IP per window (Redis-shared when up).
# Optional (defaults: 60000 / 300 / 30). Where: local `.env`.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=30

# Sheet tree Redis cache TTL seconds (default 3600). HTTP Cache-Control remains max-age=300.
# Optional. Where: local `.env`.
SHEET_CACHE_TTL_SECONDS=3600
