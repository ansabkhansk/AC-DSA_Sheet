# Copy to .env and adjust. Never commit .env.

# development | test | production
NODE_ENV=development

# Port the API listens on (the Vite dev server proxies /api here).
PORT=4000

# MongoDB from infra/docker-compose.yml.
MONGO_URI=mongodb://localhost:27017/dsa-sheet

# Optional. Mongoose connection pool size (default 50).
MONGO_POOL_SIZE=50

# Redis from infra/docker-compose.yml. Set REDIS_ENABLED=false to run without Redis.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# Used by auth in P3. Local placeholder only — replace in real deployments.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret

# Set true behind HTTPS in production. Keep false for local http://localhost.
COOKIE_SECURE=false

# Frontend origin allowed by CORS (Vite default).
CORS_ORIGIN=http://localhost:5173

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limiting (P8). Auth is intentionally stricter than the general API.
# Window is milliseconds; max is requests per IP per window (shared via Redis when up).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=30

# Sheet tree Redis cache TTL in seconds (default 1 hour). Cache-Control on responses is max-age=300.
SHEET_CACHE_TTL_SECONDS=3600
