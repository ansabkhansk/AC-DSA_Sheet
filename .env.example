# Copy to .env and adjust. Never commit .env.

# Port the API listens on (the Vite dev server proxies /api here).
PORT=4000

# MongoDB from infra/docker-compose.yml.
MONGO_URI=mongodb://localhost:27017/dsa-sheet

# Redis from infra/docker-compose.yml. Set REDIS_ENABLED=false to run without Redis.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
